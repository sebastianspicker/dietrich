/* Workbench shell + left session rail with live MRU entries. */

#workbench {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
    background: #0F141A;
}

#session-rail {
    display: none;
    width: 26;
    height: 1fr;
    margin-right: 2;
    padding: 0;
    background: #151B23;
}

#session-head {
    height: 2;
    padding: 0 1;
    color: #9AA6B6;
    text-style: bold;
    content-align: left middle;
}

#recent-list {
    height: 1fr;
    min-height: 4;
    padding: 0 1 1 1;
    background: #151B23;
    color: #E4E9F0;
    border: none;
    scrollbar-background: #151B23;
    scrollbar-color: #2A3442;
}

#recent-list > .option-list--option {
    padding: 0 1;
    color: #E4E9F0;
}

#recent-list > .option-list--option-highlighted {
    background: #232D3A;
    color: #E4E9F0;
    border-left: tall #8FB4DC;
}

#recent-list > .option-list--option-hover { background: #1C242F; }

#session-empty {
    height: auto;
    min-height: 3;
    padding: 1;
    color: #8896A9;
    display: none;
}

#session-empty.-visible { display: block; }

#session-foot {
    height: 2;
    padding: 0 1;
    color: #8896A9;
    border-top: solid #2A3442;
    content-align: left middle;
}

#main-column {
    width: 1fr;
    height: 1fr;
    max-width: 104;
}
