/* Werkbank II tokens shared with brand.py and assets/brand/palette.json.
   #0F141A #151B23 #1C242F #232D3A #2A3442 #E4E9F0 #9AA6B6 #8896A9
   #D4B36A #C4A35A #8FB4DC #82B58F #D9A45B #D37C6E */

Screen {
    layout: vertical;
    background: #0F141A;
    color: #E4E9F0;
}

.section-label {
    height: 1;
    color: #9AA6B6;
    text-style: bold;
}

.field-label {
    width: 16;
    padding-top: 1;
    color: #8896A9;
}

/* Keyboard focus remains unambiguous against the tonal surfaces. */
Input:focus, Button:focus, Checkbox:focus, CollapsibleTitle:focus, OptionList:focus {
    border: tall #D4B36A;
}

#input-path:focus,
#btn-inspect:focus {
    border: tall #8FB4DC;
}

Button:disabled {
    text-style: dim;
}
