/* Dense, editable intake and action controls on tonal Workbench surfaces. */

#path-row { height: 3; }

#path-row Input, #out-row Input {
    width: 1fr;
    height: 3;
    padding: 0 1;
    background: #1C242F;
    color: #E4E9F0;
    border: solid #2A3442;
}

#file-kind {
    width: 10;
    height: 3;
    content-align: center middle;
    background: #232D3A;
    color: #9AA6B6;
}

#btn-inspect {
    width: 16;
    height: 3;
    margin-left: 1;
    background: #35587E;
    color: #E4E9F0;
    border: solid #8FB4DC;
    text-style: bold;
}

#out-row { height: 4; }

#overwrite-block {
    width: 36;
    height: 4;
    margin-left: 1;
    padding: 0 1;
    background: #151B23;
}

#chk-overwrite { height: 2; color: #E4E9F0; }
#overwrite-hint { height: 2; color: #8896A9; }

#btn-unlock {
    width: 28;
    height: 3;
    margin-left: 1;
    background: #C4A35A;
    color: #1A1F27;
    border: solid #C4A35A;
    text-style: bold;
}

#utility-row { height: auto; min-height: 3; margin-bottom: 1; }

#advanced { width: 1fr; height: auto; padding: 0; background: #151B23; }

#advanced CollapsibleTitle {
    height: 3;
    padding: 0 1;
    background: #151B23;
    color: #9AA6B6;
    border: none;
    content-align: left middle;
}

#advanced CollapsibleContents {
    padding: 0;
    background: #151B23;
    border-top: solid #2A3442;
}

#adv-grid { height: auto; max-height: 18; padding: 0 1 1 1; }
#adv-grid Input { margin-bottom: 0; background: #1C242F; border: solid #2A3442; }

#secondary-actions { width: 36; height: 3; }

#btn-export, #btn-quit, #btn-cancel {
    width: 1fr;
    min-width: 0;
    height: 3;
    margin-left: 1;
    background: #151B23;
    color: #9AA6B6;
    border: solid #2A3442;
    text-style: bold;
}

#activity-panel { height: 1fr; min-height: 3; background: #151B23; }

#activity-header { height: 2; padding: 0 1; border-bottom: solid #2A3442; }

#activity-header .section-label {
    width: 1fr;
    height: 1fr;
    content-align: left middle;
    color: #9AA6B6;
}

#session-state {
    width: 16;
    height: 1fr;
    content-align: right middle;
    color: #8896A9;
    text-style: bold;
}

#log { height: 1fr; padding: 0 1; background: #151B23; color: #E4E9F0; border: none; }

#hash-result-panel { display: none; height: 5; }
#hash-result { height: 4; }
