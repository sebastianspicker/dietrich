/* Compact brand and authority chrome: tone carries hierarchy, not plaques. */

#brand-row {
    height: 4;
    padding: 0 2;
    background: #0F141A;
}

#brand-block {
    width: 1fr;
    height: 4;
}

#brand-name {
    height: 2;
    padding-top: 1;
    color: #E4E9F0;
    text-style: bold;
}

#brand-subtitle {
    height: 1;
    color: #9AA6B6;
}

#brand-meta {
    width: 36;
    height: 4;
    content-align: right middle;
    color: #8896A9;
}

#banner {
    height: 2;
    margin: 0 2;
    padding: 0 1;
    background: #151B23;
    color: #9AA6B6;
    border-left: tall #8FB4DC;
}

#key-footer {
    height: 2;
    padding: 0 2;
    background: #0F141A;
    color: #8896A9;
    border-top: solid #2A3442;
    content-align: left middle;
}
